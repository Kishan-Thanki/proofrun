# Environment for the Proofrun service. Keep this file private:
#   sudo install -m 600 proofrun.env.example /etc/proofrun/proofrun.env
#
# Referenced from monitors.yaml as ${env.NAME}. A missing variable is a
# configuration error that names the variable.
API_TOKEN=replace-me

# Alerts on health changes (optional).
PROOFRUN_WEBHOOK_URL=https://example.com/hooks/proofrun

# Metrics on loopback (optional). Scrape from the same host, or put a
# reverse proxy in front. The endpoint has no authentication.
PROOFRUN_METRICS_PORT=9464
